{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dungeon-portal/personaggi.schema.json",
  "title": "Catalogo personaggi della campagna",
  "description": "Anagrafica dei personaggi della campagna, popolata e arricchita sessione dopo sessione.",
  "type": "object",
  "required": ["campagna", "personaggi"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "campagna": {
      "type": "string",
      "description": "Slug della campagna (es. 'discesa-averno')."
    },
    "ultimoAggiornamento": {
      "type": "integer",
      "description": "Numero dell'ultima sessione i cui contenuti sono stati riversati in questo file."
    },
    "personaggi": {
      "type": "array",
      "items": { "$ref": "#/definitions/personaggio" }
    }
  },
  "definitions": {
    "personaggio": {
      "type": "object",
      "required": ["id", "nome", "categoria", "stato", "primaApparizione"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificativo univoco in kebab-case (es. 'nathan', 'fernand-reglisse')."
        },
        "nome": { "type": "string" },
        "categoria": {
          "type": "string",
          "enum": ["party", "alleato", "avversario", "secondario"],
          "description": "Rispecchia le cartelle in personaggi/ (Party, Alleati, Avversari, Secondari)."
        },
        "ruolo": {
          "type": "string",
          "description": "Classe, mestiere o funzione narrativa (es. 'Paladino', 'Erborista')."
        },
        "razza": { "type": "string" },
        "eta": {
          "type": "string",
          "description": "Stringa libera: l'eta puo essere approssimata o ignota."
        },
        "immagine": {
          "type": ["string", "null"],
          "description": "Percorso del ritratto, o null se non disponibile."
        },
        "aspetto": { "type": "string" },
        "personalita": { "type": "string" },
        "background": { "type": "string" },
        "stato": {
          "type": "string",
          "enum": ["vivo", "morto", "scomparso", "ignoto"],
          "description": "Stato noto al gruppo all'ultimo aggiornamento."
        },
        "primaApparizione": {
          "type": "integer",
          "description": "Numero della sessione in cui compare per la prima volta."
        },
        "apparizioni": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Sessioni in cui il personaggio compare o e protagonista."
        },
        "note": {
          "type": "array",
          "description": "Annotazioni cronologiche: cio che si scopre, sessione per sessione.",
          "items": {
            "type": "object",
            "required": ["sessione", "testo"],
            "additionalProperties": false,
            "properties": {
              "sessione": { "type": "integer" },
              "testo": { "type": "string" }
            }
          }
        },
        "misteri": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domande aperte / fili narrativi irrisolti legati al personaggio."
        },
        "correlazioni": {
          "type": "array",
          "description": "Relazioni con altri personaggi del catalogo.",
          "items": {
            "type": "object",
            "required": ["personaggio", "tipo", "descrizione"],
            "additionalProperties": false,
            "properties": {
              "personaggio": {
                "type": "string",
                "description": "id di un altro personaggio in questo file."
              },
              "tipo": {
                "type": "string",
                "description": "Natura del legame (es. 'mentore', 'compagno', 'datore di lavoro', 'famiglia', 'sospetta')."
              },
              "descrizione": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
